# Warhammer 40k: Wrath & Glory VTT - Frontend Environment Variables

# In production on Vercel, set this to your Render/Railway backend URL:
# Example: https://warhammer-vtt-backend.onrender.com
VITE_API_URL=https://seu-backend.onrender.com

# Optional: Set this if your WebSocket server is hosted on a separate URL
# (Default fallback uses VITE_API_URL)
VITE_SOCKET_URL=https://seu-backend.onrender.com
