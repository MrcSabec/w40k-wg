# Warhammer 40k: Wrath & Glory VTT - Server Environment Variables

# Port (assigned automatically by Render, Railway, or Heroku)
PORT=3001

# Allowed Frontend Origins for CORS (e.g. Vercel domain or comma-separated list)
# Default is '*' (permissive). In production, set to your Vercel URL:
CLIENT_ORIGIN=https://seu-vtt.vercel.app,http://localhost:5173

# Directory where the SQLite database is saved
# When using Render Persistent Disk, set this to the mount path (e.g. /var/data):
DATA_DIR=./data
